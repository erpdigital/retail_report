 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n.document-title {\n    padding-top: 6mm;\n    font-family: 'Open Sans Condensed',sans-serif;\n    font-size: 18pt;\n}\nth, td {\n    border: 1px solid black;\n}\n.table {\n    margin: 0px !important;\n}\n</style>\n{% set status_ru = {\"Draft\": \"\u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a\", \"Submitted\": \"\u041e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e\", \"Ordered\": \"\u0417\u0430\u043a\u0430\u0437\u0430\u043d\u043e\", \"Cancelled\": \"\u041e\u0442\u043c\u0435\u043d\u0435\u043d\u043e\"} %}\n{% set company = frappe.get_doc(\"Company\", doc.company) %}\n{% if doc.supplier %}\n{% set supplier = frappe.get_doc(\"Supplier\", doc.supplier) %}\n{% endif %}\n<h2 class=\"document-title\">\n    <div style=\"text-align: center;\">\n        <img alt=\"\u041b\u043e\u0433\u043e\u0442\u0438\u043f\" src=\"/files/tolkun.png\" style=\"width: 100px;\" width=\"100\"><br>\n        \u0417\u0430\u044f\u0432\u043a\u0430 \u043d\u0430 \u0437\u0430\u043a\u0443\u043f\u043a\u0443 {{ doc.name }}\n    </div>\n</h2>\n<div class=\"page-break\">\n    <!-- HEAD -->\n    <!-- FOOTER -->\n    <div id=\"footer-html\" class=\"visible-pdf\">\n        <span id=\"pagenum\" class=\"small page-number visible-pdf pull-right\">\n            \u0421\u0442\u0440: {{ _(\"{0}/{1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\n        </span>\n    </div>\n    <div class=\"sender_receiver\">\n        <!-- Receiver -->\n        <div id=\"receiver\" style=\"\">\n            <b style=\"font-size: 12pt;\">\u041a\u043e\u043c\u043f\u0430\u043d\u0438\u044f :  {{ company.company_name }} </b><br>\n            {% if supplier %}\n            <b style=\"font-size: 12pt;\">\u041f\u043e\u0441\u0442\u0430\u0432\u0449\u0438\u043a : {{ supplier.supplier_name }} </b><br>\n            {% endif %}\n            <b style=\"font-size: 12pt;\">\u0421\u0442\u0430\u0442\u0443\u0441 : {{ status_ru.get(doc.status, doc.status) }} </b><br>\n            <b style=\"font-size: 12pt;\">\u0417\u0430\u044f\u0432\u0438\u0442\u0435\u043b\u044c :  {{ frappe.db.get_value(\"User\", doc.owner, \"full_name\") or doc.owner }} </b><br>\n        </div>\n    </div>\n    <!-- CONTENT -->\n    <div id=\"text\">\n        <div class=\"row\" style=\"font-size: 7pt; padding-top: 3mm;\">\n            {% if doc.transaction_date %}\n            <div class=\"col-xs-2\">\n                <strong>\u0414\u0430\u0442\u0430: </strong>\n                <p>{{ frappe.utils.formatdate(doc.transaction_date, \"dd.mm.yyyy\") }}\n                <p>\n            </div>\n            {% endif %}\n            {% if doc.schedule_date %}\n            <div class=\"col-xs-2\">\n                <strong>\u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043a \u0434\u0430\u0442\u0435: </strong>\n                <p>{{ frappe.utils.formatdate(doc.schedule_date, \"dd.mm.yyyy\") }}\n                <p>\n            </div>\n            {% endif %}\n        </div>\n        <table class=\"text-small\" style=\"font-size: 9pt;width: 100%; table-layout: auto;\">\n            <thead class=\"black-border\">\n                <tr style=\"border-bottom: 2px solid black;\">\n                    <th style=\"width: 5%\" class=\"text-center\">\u2116</th>\n                    <th style=\"width: 15%\" class=\"text-center\">\u0410\u0440\u0442\u0438\u043a\u0443\u043b</th>\n                    <th style=\"width: 40%\" class=\"text-center\">\u041d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435</th>\n                    <th style=\"width: 15%\" class=\"text-center\">\u041a\u043e\u043b-\u0432\u043e</th>\n                    <th style=\"width: 12%\" class=\"text-center\">\u0412\u0435\u0441 \u0435\u0434. (\u043a\u0433)</th>\n                    <th style=\"width: 13%\" class=\"text-right\">\u041e\u0431\u0449\u0438\u0439 \u0432\u0435\u0441 (\u043a\u0433)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for n in doc.items %}\n                <tr style=\"border-top: 1px solid black;\">\n                    <td style=\"width: 5%\" class=\"text-left\">{{ loop.index }}</td>\n                    <td style=\"width: 15%\" class=\"text-left\">{{ n.item_code }}</td>\n                    <td style=\"width: 40%\" class=\"text-left\"> {{ n.item_name or '' }} </td>\n                    <td style=\"width: 15%; border: 3px solid black;\" class=\"text-left\">\n                        {% if n.qty%1 != 0 %}\n                            {{ n.qty|float }}\n                        {% else %}\n                            {{ n.qty|int }}\n                        {% endif %}\n                        {{ n.uom or '' }}\n                    </td>\n                    <td style=\"width: 12%;\" class=\"text-left\">\n                        {{ '%0.2f'| format(n.weight_per_unit|float) }} {{ n.weight_uom or '' }}\n                    </td>\n                    <td style=\"width: 13%;\" class=\"text-right\"> {{ '%0.2f'| format(n.total_weight|float) }} {{ n.weight_uom or '' }}\n                    </td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n        <div class=\"row total\" style=\"font-size: 9pt;\">\n            <div class=\"col-xs-12 pull-left\" style=\"text-decoration: underline;\">\n                <b style=\"font-size: 14pt; margin-top: 10mm;\"> \u0412\u0441\u0435\u0433\u043e \u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0439 {{ doc.items|length }}, \u043d\u0430 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e {% if doc.total_qty%1 != 0 %}{{ '%0.2f'| format(doc.total_qty|float) }}{% else %}{{ doc.total_qty|int }}{% endif %} </b>\n                <br>\n                <b style=\"font-size: 12pt; margin-top: 5mm;\">\u041e\u0431\u0449\u0438\u0439 \u0432\u0435\u0441: {{ '%0.2f'| format(doc.total_weight|float) }} \u043a\u0433</b>\n            </div>\n        </div>\n    </div>\n    <div style=\"display: flex; justify-content: space-between; margin-top: 10mm;\">\n        <div style=\"flex: 1; border-bottom: 1px solid black; margin-right: 10mm;\">\n            <p style=\"margin: 0;\">\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u043b:</p>\n        </div>\n        <div style=\"flex: 1; border-bottom: 1px solid black;\">\n            <p style=\"margin: 0;\">\u041f\u043e\u043b\u0443\u0447\u0438\u043b:</p>\n        </div>\n    </div>\n</div>\n",
